
<%- include('header', { title: 'Регистрация' }) %>


<h1><%= title %></h1>

<% if (errors.lenght) { %>
<ul>
    <% errors.forEach (e => { %>
<li><%= e%></li>
   <% }) %>
</ul>
<% } %>

<form method="POST" action="/register">
        <input name="login" placeholder="Логин"><br>
        <input name="tel" placeholder="Телефон"><br>
        <input name="email" type="email" placeholder="Почта"><br>
        <input name="password" type="password" placeholder="Пароль"><br>
        <button> Создать пользователя</button>
        </form>
    

        <%- include('footer') %>